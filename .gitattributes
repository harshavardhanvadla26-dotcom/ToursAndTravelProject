# Auto-detect text/binary and normalize line endings
* text=auto

# Ensure scripts and source files use LF
/mvnw text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Batch files keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.ear binary

# Node modules and other generated folders
node_modules/** binary
src/main/Frontend/node_modules/** binary
target/** binary
